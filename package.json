{
  "name": "jev-uicheck-fast",
  "version": "0.0.0",
  "private": true,
  "description": "Automatic UI verification for local agent-driven development",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "jev-uicheck-fast": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "benchmarks/README.md",
    "benchmarks/RESULTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run build && node dist/cli.js",
    "check:jev": "npm run build && node --env-file=.env scripts/check-jev.mjs",
    "bench": "npm run build && node benchmarks/run.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
